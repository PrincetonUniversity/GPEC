&match_input
	filename="euler.bin"
	full=f

	ideal_flag=t
	contour_flag=t

	sol_num=1 		!DCON eigenfunction index for MATCH (1 = most unstable); sol_num=n>1 writes solutions<n>.bin

	res_flag=f
	ff0=1e6
	ff1=1e6

	scan_flag=f
	big=1
	small=1e-6
	ns=100

	z_level_type="midplane"
	phi_level=85

	root_flag=f
	root=(1e-2,0)

/
